{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "edlr",
  "version": "0.1.0",
  "identifier": "dev.himanoa.edlr",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../frontend"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "edlr",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
